# Server
PORT=5000
NODE_ENV=development

# Database
# Local MongoDB for hackathon demos:
MONGODB_URI=mongodb://127.0.0.1:27017/omen
# MongoDB Atlas format:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-name>.<cluster-id>.mongodb.net/omen?retryWrites=true&w=majority

# Blockchain
RPC_URL=https://rpc-mumbai.maticvigil.com
CONTRACT_ADDRESS=0xYourContractAddress
ADMIN_PRIVATE_KEY=your_admin_private_key
ADMIN_WALLET_ADDRESS=0xYourAdminWalletAddress

# JWT
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRE=7d
ADMIN_EMAIL=admin@omen.com
ADMIN_PASSWORD=change_this_admin_password

# ML API
ML_API_URL=http://localhost:8000/predict

# External APIs
PHISHTANK_API_KEY=your_key
GOOGLE_SAFE_BROWSING_API_KEY=your_key
WHOIS_API_KEY=your_key
